package views

import (
    sqlc "ProyectoFinanzas/db/sqlc"
    "fmt"
)

templ MovimientoEditForm(mov sqlc.Movimiento) {
    	<!DOCTYPE html>
	<html lang="es">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<link rel="stylesheet" href="/static/styles.css"/>
		<title>{ "UPDATE" }</title>
	</head>
    <body>
        <div class="pantalla-edicion">
            <div class="form-card card-con-fondo">
                <h2>Editar Movimiento</h2>
                <form action={ templ.SafeURL(fmt.Sprintf("/movimientos/%d", mov.IDMovimiento)) } method="POST">
                    <input type="hidden" name="_method" value="PUT"/>

                    <div class="form-group">
                        <label for="monto_mov">Monto:</label>
                        <input type="number" step="any" name="monto" id="monto_mov" value={ fmt.Sprintf("%.2f", mov.Monto) } required class="form-input"/>
                    </div>

                    <div class="form-group">
                        <label for="tipo_mov">Tipo:</label>
                        <select name="tipo" id="tipo_mov" required class="form-input">
                            <option value="I" selected={ mov.Tipo == "I" }>Ingreso</option>
                            <option value="G" selected={ mov.Tipo == "G" }>Gasto</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="descripcion_mov">Descripción:</label>
                        <input type="text" name="descripcion" id="descripcion_mov" value={ mov.Descripcion.String } class="form-input"/>
                    </div>

                    <div class="form-group">
                        <label for="fechaMovimiento">Fecha de Movimiento:</label>
                        <input type="date" name="fechaMovimiento" 
                            value={ mov.FechaMovimiento.Format("2006-01-02") } 
                            id="fechaMovimiento" class="form-input" required/>
                    </div>
                    <div>
                        <button type="submit" class="btn-G-C">Guardar cambios</button>                
                    </div>

                </form>
                <div class="form-group">
                    <form action="/" method="GET"> 
                        <button type="submit" class="btn-borrar">Cancelar</button>
                    </form>
                </div>
            </div>
        </div>
    </body>
	</html>
}